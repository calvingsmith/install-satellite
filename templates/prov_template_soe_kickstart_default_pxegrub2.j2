<%#
name: SOE Kickstart Default PXEGrub2
snippet: false
model: ProvisioningTemplate
kind: PXEGrub2
oses:
- AlmaLinux
- CentOS
- CentOS_Stream
- Fedora
- RedHat
- Rocky
description: |
  Grub2 config for kickstart (TFTP and HTTP boot). Clone of Foreman "Kickstart default PXEGrub2".

  When the subnet has HTTPBoot, the default entry is EFI HTTP (efi_http) if the HTTP port is enabled,
  else EFI HTTPS (efi_https) if only HTTPS is enabled — so the HTTP(S) installer path is chosen after
  the loader timeout instead of the first TFTP-relative entry.

  Host parameters (optional):
  - loader_timeout: seconds before the default entry boots (default 10)
  - default_grub_install_entry: menu index (0-based) or GRUB menu id (e.g. efi_http, efi_https).
    If unset, defaults as above when HTTPBoot is available; otherwise 0.
test_on:
- host4dhcp
- host6dhcp
- host4and6dhcp
- host4static
- host6static
-%>
# This file was deployed via '<%= template_name %>' template
<%
 rhel_compatible = @host.operatingsystem.family == 'Redhat' && @host.operatingsystem.name != 'Fedora'
 os_major = @host.operatingsystem.major.to_i

 if rhel_compatible && os_major == 7 && ['i386','x86_64'].include?(@host.architecture.to_s) && @host.pxe_loader_efi?
 linuxcmd = "linuxefi"
 initrdcmd = "initrdefi"
 else
 linuxcmd = "linux"
 initrdcmd = "initrd"
 end

 subnet_for_grub = @host.provision_interface.subnet || @host.provision_interface.subnet6
 http_boot_http = subnet_for_grub && subnet_for_grub.httpboot && subnet_for_grub.httpboot.httpboot_http_port
 http_boot_https = subnet_for_grub && subnet_for_grub.httpboot && subnet_for_grub.httpboot.httpboot_https_port
 grub_default = host_param('default_grub_install_entry')
 if grub_default.nil? && http_boot_http
   grub_default = 'efi_http'
 elsif grub_default.nil? && http_boot_https && !http_boot_http
   grub_default = 'efi_https'
 elsif grub_default.nil?
   grub_default = 0
 end
 # No =~ / regex here: Safemode blocks Regexp/String matching (match3) on jailed strings.
 gd_str = grub_default.to_s
 grub_default_digit_only = !gd_str.empty?
 if grub_default_digit_only
   gi = 0
   while grub_default_digit_only && gi < gd_str.length
     ch = gd_str[gi]
     grub_default_digit_only = false if ch < '0' || ch > '9'
     gi += 1
   end
 end
 if grub_default_digit_only
   grub_default_render = gd_str.to_i
 else
   grub_default_render = "'#{grub_default}'"
 end
 loader_timeout_sec = host_param('loader_timeout')
 loader_timeout_sec = 10 if loader_timeout_sec.nil? || loader_timeout_sec.to_s.empty?
 loader_timeout_sec = loader_timeout_sec.to_i
 loader_timeout_sec = 10 if loader_timeout_sec <= 0
-%>

set default=<%= grub_default_render %>
set timeout=<%= loader_timeout_sec %>

menuentry '<%= template_name %>' {
 <%= linuxcmd %> <%= @kernel %> <%= pxe_kernel_options %> <%= snippet("kickstart_kernel_options").strip %>
 <%= initrdcmd %> <%= @initrd %>
}

<%
# Workaround for https://bugzilla.redhat.com/show_bug.cgi?id=1811561 and https://bugzilla.redhat.com/show_bug.cgi?id=1842893
subnet = @host.provision_interface.subnet || @host.provision_interface.subnet6
if subnet && subnet.httpboot
 proxy_http_port = subnet.httpboot.httpboot_http_port
 proxy_https_port = subnet.httpboot.httpboot_https_port
 # Workaround for "no DNS server configured" https://bugzilla.redhat.com/show_bug.cgi?id=1842509
 proxy_host = dns_lookup(subnet.httpboot.hostname)
-%>
<% if proxy_http_port -%>
menuentry '<%= template_name %> EFI HTTP' --id efi_http {
 <%= linuxcmd %> (http,<%= proxy_host %>:<%= proxy_http_port %>)/httpboot/<%= @kernel %> <%= pxe_kernel_options %> <%= snippet("kickstart_kernel_options").strip %>
 <%= initrdcmd %> (http,<%= proxy_host %>:<%= proxy_http_port %>)/httpboot/<%= @initrd %>
}
<% else -%>
# Smart proxy does not have HTTPBoot feature with HTTP port enabled, skipping EFI HTTP boot menu entry
<% end -%>

<% if proxy_https_port -%>
menuentry '<%= template_name %> EFI HTTPS' --id efi_https {
 <%= linuxcmd %> (https,<%= proxy_host %>:<%= proxy_https_port %>)/httpboot/<%= @kernel %> <%= pxe_kernel_options %> <%= snippet("kickstart_kernel_options").strip %>
 <%= initrdcmd %> (https,<%= proxy_host %>:<%= proxy_https_port %>)/httpboot/<%= @initrd %>
}
<% else -%>
# Smart proxy does not have HTTPBoot feature with HTTPS port enabled, skipping EFI HTTPS boot menu entry
<% end -%>

<% end %>

<%= snippet_if_exists(template_name + " custom menu") %>
