  # Replace "eth0" with the actual interface name if different
  IFACE="eth0"
  CON_NAME="eth0-static"

  # Delete any existing auto-generated connection profiles for the interface
  nmcli con show --match interface "$IFACE" | grep "$IFACE" | awk "{print \$1}" | xargs -r nmcli con delete

  # Add a new static connection
  nmcli con add type ethernet ifname "$IFACE" con-name "$CON_NAME" ipv4.method manual ipv4.addresses "{{ static_ip }}/{{ subnet_cidr }}" ipv4.gateway "{{ gateway_ip }}" ipv4.dns "{{ dns_servers }}  " autoconnect yes
  # Bring the connection up (optional, as it should autoconnect on boot)
  nmcli con up "$CON_NAME"